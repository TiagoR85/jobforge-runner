<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwConfigExceptions="true">
  <variables>
    <variable name="svc" value="${environment:variable=SERVICE_NAME:default=jobforge-runner}"/>
  </variables>
  <targets async="true">
    <target name="json" type="Console">
      <layout type="JsonLayout" includeAllProperties="true">
        <attribute name="ts" layout="${date:format=o}"/>
        <attribute name="level" layout="${level:uppercase=true}"/>
        <attribute name="svc" layout="${var:svc}"/>
        <attribute name="msg" layout="${message}"/>
        <attribute name="ex" layout="${exception:format=tostring}"/>
      </layout>
    </target>
  </targets>
  <rules>
    <logger name="*" minlevel="Info" writeTo="json"/>
  </rules>
</nlog>
